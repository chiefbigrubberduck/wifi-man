# Set MAC addr function
SETMAC(){
    echo "Card exists..."
    read -r -p "Select MAC changing method?
----------------------------
1. Input specific MAC address
2. Randomized MAC
3. Revert to factory MAC address
4. Set random Manufacturer MAC
----------------------------
Enter number: " MACCHOICE
    if ! [[ "$MACCHOICE" =~ ^[1-4]$ ]]; then
        echo "Invalid choice."
        echo "Exiting..."
        exit
    fi
    if [ "$MACCHOICE" = "1" ]; then
        read -r -p "Enter the specific MAC address you want (Must be 12 digits, every 2 digits separated by commas): " MACINPUT
        sudo ip link set "$SELECTED" down || { echo "Error: Setting card down with ip link failed..."; exit; }
        sudo macchanger -m "$MACINPUT" "$SELECTED" || { echo "Error: Setting MAC address failed..."; exit; }
        sudo rfkill unblock "$RFKILL_ID" || { echo "Error: Freeing card with rfkill failed..."; exit; }
        sudo ip link set "$SELECTED" up || { echo "Error: Putting card back up with ip link failed..."; exit; }
        echo "Done, MAC address changed to: "$MACINPUT""
        exit
    fi

    if [ "$MACCHOICE" = "2" ]; then
        echo "Setting randomized MAC address..."
        sudo ip link set "$SELECTED" down || { echo "Error: Setting card down with ip link failed..."; exit; }
        sudo macchanger -r -b "$SELECTED" || { echo "Error: Setting MAC address failed..."; exit; }
        sudo rfkill unblock "$RFKILL_ID" || { echo "Error: Freeing card with rfkill failed..."; exit; }
        sudo ip link set "$SELECTED" up || { echo "Error: Putting card back up with ip link failed..."; exit; }
        echo "Done... MAC randomized."
        exit
    fi

    if [ "$MACCHOICE" = "3" ]; then
        read -r -p "Are you sure you want to revert to your factory MAC address? [y/N]: " FACTORYCHOICE
        if [[ "$FACTORYCHOICE" =~ ^[yY][eE]?[sS]?$ ]]; then
            echo "Setting to factory MAC address..."
            sudo ip link set "$SELECTED" down || { echo "Error: Setting card down with ip link failed..."; exit; }
            sudo macchanger -p "$SELECTED" || { echo "Error: Setting MAC address failed..."; exit; }
            sudo rfkill unblock "$RFKILL_ID" || { echo "Error: Freeing card with rfkill failed..."; exit; }
            sudo ip link set "$SELECTED" up || { echo "Error: Putting card back up with ip link failed..."; exit; }
            echo "Reverted to factory MAC address..."
            exit
        else
            echo "Quitting... Not reverting to factory MAC"
            exit
        fi
    fi

    if [ "$MACCHOICE" = "4" ]; then
        echo "Setting random manufacturer MAC..."
        sudo ip link set "$SELECTED" down || { echo "Error: Setting card down with ip link failed..."; exit; }
        sudo macchanger -A "$SELECTED" || { echo "Error: Setting MAC address failed..."; exit; }
        sudo rfkill unblock "$RFKILL_ID" || { echo "Error: Freeing card with rfkill failed..."; exit; }
        sudo ip link set "$SELECTED" up || { echo "Error: Putting card back up with ip link failed..."; exit; }
        echo "Manufacturer MAC set."
        exit
    fi
exit
}

