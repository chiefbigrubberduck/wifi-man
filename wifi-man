# Hostname change function
SETHOSTNAME() {
    echo "Current Hostname: $(hostname)"
    read -r -p "Should the hostname change be Temporary (1) or Permanent (2)? Enter a number: " HOSTCHOICE
    if ! [[ "$HOSTCHOICE" =~ ^[1-2]$ ]]; then
        echo "Error: Invalid number entered. Enter either 1 or 2."
        exit
    fi
    if [ "$HOSTCHOICE" = "1" ]; then
        echo "Changing hostname temporarily... This will change after a reboot."
        read -r -p "New hostname, enter a connected set of characters: " HOSTNAMENEW
        sudo hostname "$HOSTNAMENEW"
        echo "Hostname set to: "$HOSTNAMENEW""
        exec bash
        exit
        exit
        exit
    fi
    if [ "$HOSTCHOICE" = "2" ]; then
        echo "Changing hostname permanently..."
        read -r -p "New hostname, enter a connected set of characters: " HOSTNAMENEWPERM
        echo ""$HOSTNAMENEWPERM"" | sudo tee /etc/hostname > /dev/null
        sudo hostname "$HOSTNAMENEWPERM"
        echo "Hostname permanently set to: "$HOSTNAMENEWPERM""
        exec bash
        exit
        exit
        exit
    fi
}

