        sudo ip link set dev "$SELECTED" name "$INTERFACENAMENEW" || { echo "Error: Changing interface name failed, did you enter a valid word?"; exit; }
        echo "Bringing card back up..."
        sudo rfkill unblock "$RFKILL_ID" || { echo "Error: Freeing card with rfkill failed..."; exit; }
        sudo ip link set "$INTERFACENAMENEW" up || { echo "Error: Putting card back up with ip link failed..."; exit; }
        echo "Done... Interface name changed."
        echo "Interface name: "$INTERFACENAMENEW""
        echo "Name change will reset after reboot."
        exit
    else
        echo "Not changing interface name..."
        exit
    fi
exit
}

# TX Power function set
SETTXPOWER() {
read -r -p "Enter chosen TX Power (2000-3000 recommended, more can harm you Wi-Fi card): " TXCHOICE
    if [[ ! "$TXCHOICE" =~ ^[0-9]+$ ]]; then
        echo "Invalid TX choice. Try again."
        exit
    fi
    read -r -p "Setting TX Power to: "$TXCHOICE", proceed? [y/N]: " TXVERIFY
    if [[ "$TXVERIFY" =~ ^[yY][eE]?[sS]?$ ]]; then
        sudo ip link set "$SELECTED" down || { echo "Error: Setting card down with ip link failed..."; exit; }
        sudo iw dev "$SELECTED" set txpower fixed $TXCHOICE || { echo "Failed setting TX Power... Your card may have a country code enforced TX limit"; exit; }
        sudo rfkill unblock "$RFKILL_ID" || { echo "Error: Freeing card with rfkill failed..."; exit; }
        sudo ip link set "$SELECTED" up || { echo "Error: Putting card back up with ip link failed..."; exit; }
        echo "TX Power set to: "$TXCHOICE""
        exit
    fi
    exit
}

# Country code change function
CCSP() {
    echo "Card exists..."
    echo -n "This will change your machine, Wi-Fi country code, system-wide."
    echo " Some recommended countries for use are:
Costa Rica - CR
United States - US
Japan - JP3
------------------------------
For a full list, run wifi-man as: wifi-man --listcc"
    echo "----------------------------"
    read -r -p "Do you want to proceed? [Y/n] " COUNTRYPROCEED
    if [[ "$COUNTRYPROCEED" =~ ^[yY][eE]?[sS]?$ ]]; then
        echo "Proceeding..."
        read -r -p "Enter a valid ISO/IEC, 3166-1, alpha2 code (Country code): " DESIREDCOUNTRY
        sudo iw reg get > /dev/null
        sudo ip link set "$SELECTED" down || { echo "Error: Setting card down with ip link failed..."; exit; }
        sudo iw reg set "$DESIREDCOUNTRY" || { echo "Error: Setting country code with iw failed..."; exit; }
        sudo rfkill unblock "$RFKILL_ID" || { echo "Error: Freeing card with rfkill failed..."; exit; }
        sudo ip link set "$SELECTED" up || { echo "Error: Putting card back up with ip link failed..."; exit; }
        echo "Country code changed to: "$DESIREDCOUNTRY""
        exit
    else
        echo "Not changing interface country code..."
        echo "Exiting..."
        exit
    fi
exit
}

# Promiscuous mode functions
SETPROMISCON() {
    echo "Turning Promiscuous mode on for "$SELECTED"..."
    sudo ip link "$SELECTED" set promisc on || { echo "Error: Turning on promiscuous for "$SELECTED" failed..."; exit; }
    echo "Promiscuous mode turned on for "$SELECTED"..."
    exit
}
SETPROMISCOFF() {
    echo "Turning Promiscuous mode off for "$SELECTED"..."
    sudo ip link "$SELECTED" set promisc off || { echo "Error: Turning off promiscuous for "$SELECTED" failed..."; exit; }
    echo "Promiscuous mode turned off for "$SELECTED"..."
    exit
}

# Make a VIF
# Important:  sudo iw dev wlp4s0 info | grep -Eo 'phy [0-9999999999]+' will find the phy name from the interface!!!!!!!!!!
# Important: sudo iw dev | awk '/Interface/{print $2}' can get all wireless ifaces
# Important: sudo iw dev | awk '/phy#/{phy=$1} /Interface/{print phy, $2}' gets iface with phy.
# Get phy and ifaceamount sudo iw dev | awk '/phy#/{phy=$1} /Interface/{count[phy]++} END{for(p in count) print p, count[p]}' | sort -t'#' -k2 -n
# sudo iw dev | awk '/phy#/{phy=$1} /Interface/{count[phy]++} END{for(p in count) print p, count[p]}' | awk '{print $2}' | grep -w 1
MAKEVIF() {
IFACEPHY=$(sudo iw dev "$SELECTED" info | grep -Eo 'phy [0-9999999999]+' | tr -d '[:space:]')
echo "Making interface..."
if [[ $EXTRA="managed" || $EXTRA="monitor" ]]; then
    echo "Continuing..." > /dev/null
else
    echo "Error: Invalid interface mode selected."
    echo "Exiting..."
    exit
fi
read -r -p "Enter new interface name: " MAKEVIFNAME
echo "----------------------------"
read -r -p "Interface will be...
Name: "$MAKEVIFNAME"
Type: "$EXTRA"
Proceed? [y/N]: " VIFCONFIRMATION

if [[ "$VIFCONFIRMATION" =~ ^[yY][eE]?[sS]?$ ]]; then
    echo "----------------"
    echo "Proceeding..."
    sudo iw phy "$IFACEPHY" interface add "$MAKEVIFNAME" type "$EXTRA"
    echo "Made interface: "$MAKEVIFNAME""
    echo "Done..."
    exit
else
    echo "----------------"
    echo "Not proceeding..."
    echo "Exiting..."
    exit
fi
exit

}
